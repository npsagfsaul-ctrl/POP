// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Setor {
  id          String           @id @default(cuid())
  nome        String
  senha       String?          // Senha opcional para proteger o acesso ao setor
  pops        Pop[]
  registros   RegistroDiario[]
  alertas     Alerta[]
  ocorrencias Ocorrencia[]
  prospeccoes Prospeccao[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Pop {
  id                  String    @id @default(cuid())
  titulo              String
  peso                Int // Novo campo para o Peso (ex: 2, 3, 5)
  orientacaoAvaliacao String
  instrucaoTrabalho   String
  setorId             String
  setor               Setor     @relation(fields: [setorId], references: [id], onDelete: Cascade)
  dataAgendada        DateTime? @db.Date // POP agendado para um dia específico (opcional)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model RegistroDiario {
  id      String   @id @default(cuid())
  data    DateTime @db.Date // Apenas a data, sem a hora
  setorId String
  setor   Setor    @relation(fields: [setorId], references: [id], onDelete: Cascade)

  // Usamos JSON para as respostas. 
  // Em vez de criar milhares de linhas numa tabela filha, salvamos tudo num único campo de texto estruturado.
  // Exemplo: { "pop_id_1": true, "pop_id_2": false }
  respostas Json @default("{}")
  observacoes String?

  comentarioAdmin String?
  alertaAdmin     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([data, setorId]) // Garante que exista apenas 1 checklist por setor por dia
}

model Alerta {
  id        String   @id @default(cuid())
  conteudo  String
  data      DateTime @db.Date
  setorId   String
  setor     Setor    @relation(fields: [setorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([data, setorId])
}

// ─── MINI INTRANET ───

enum TipoComunicado {
  AVISO    // Amarelo ⚠️
  NOVIDADE // Azul 🆕
  URGENTE  // Vermelho 🚨
  INFO     // Cinza ℹ️
}

model Comunicado {
  id        String         @id @default(cuid())
  titulo    String
  conteudo  String
  tipo      TipoComunicado @default(AVISO)
  destaque  Boolean        @default(false)
  expiresAt DateTime?      // Data de expiração opcional
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Lembrete {
  id        String   @id @default(cuid())
  titulo    String
  data      DateTime @db.Date
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gravidade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusOcorrencia {
  ABERTA
  RESOLVIDA
}

model Ocorrencia {
  id        String           @id @default(cuid())
  descricao String
  gravidade Gravidade        @default(MEDIA)
  status    StatusOcorrencia @default(ABERTA)
  resolucao String?          // Comentário do admin ao resolver
  setorId   String
  setor     Setor            @relation(fields: [setorId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// ─── COLETAS DO DIA ───

enum PeriodoColeta {
  MANHA
  TARDE
  RETORNO
}

enum TipoColeta {
  FIXA  // coleta recorrente da rota
  EXTRA // coleta avulsa que entrou no dia
}

enum StatusColeta {
  AGUARDANDO // coletor ainda vai passar
  COLETADO   // coletor já passou / validada
  CANCELADO  // coleta cancelada
}

model Coletor {
  id         String     @id @default(cuid())
  nome       String
  cor        String     @default("#3b82f6") // cor de identificação do coletor
  ativo      Boolean    @default(true)
  coletas    Coleta[]
  rotasFixas RotaFixa[]
  turnos     Turno[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// Veículo usado pelos coletores (checklist de saída/retorno via Turno)
model Veiculo {
  id        String   @id @default(cuid())
  nome      String   // ex: "Fiorino Branca"
  placa     String?
  ativo     Boolean  @default(true)
  turnos    Turno[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StatusTurno {
  ABERTO
  ENCERRADO
}

// Turno de um coletor com um veículo: checklist de saída (liberar rota) e de retorno (encerrar dia)
model Turno {
  id     String      @id @default(cuid())
  data   DateTime    @db.Date
  status StatusTurno @default(ABERTO)

  coletorId String
  coletor   Coletor @relation(fields: [coletorId], references: [id], onDelete: Restrict)
  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  // Checklist inicial (liberar rota)
  kmInicial          Int
  combustivelInicial String // "Cheio" | "3/4" | "1/2" | "1/4" | "Reserva"
  oleoOk             Boolean  @default(true)
  oleoObs            String?
  aguaOk             Boolean  @default(true)
  aguaObs            String?
  pneusOk            Boolean  @default(true)
  pneusObs           String?
  luzesOk            Boolean  @default(true)
  luzesObs           String?
  observacaoInicial  String?
  liberadoEm         DateTime @default(now())

  // Checklist final (encerrar dia)
  kmFinal            Int?
  abastecimentoValor Float?
  abastecimentoNota  String?
  problemaCarro      String?
  encerradoEm        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([data])
}

model Atendente {
  id          String       @id @default(cuid())
  nome        String
  ativo       Boolean      @default(true)
  coletas     Coleta[]
  prospeccoes Prospeccao[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Cliente {
  id         String     @id @default(cuid())
  nome       String
  codigo     String?    // código do cliente (o número entre parênteses na planilha)
  ativo      Boolean    @default(true)
  coletas    Coleta[]
  rotasFixas RotaFixa[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Coleta {
  id            String        @id @default(cuid())
  data          DateTime      @db.Date
  periodo       PeriodoColeta
  tipo          TipoColeta    @default(EXTRA)
  status        StatusColeta  @default(AGUARDANDO)
  horaColeta    DateTime?     // quando foi marcada como COLETADO
  observacao    String?
  naoTeveColeta Boolean       @default(false) // marca "não teve coleta" sem perder o registro

  coletorId String
  coletor   Coletor @relation(fields: [coletorId], references: [id], onDelete: Restrict)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  atendenteId String?
  atendente   Atendente? @relation(fields: [atendenteId], references: [id], onDelete: SetNull)

  // Preenchido quando a coleta foi gerada automaticamente por uma rota fixa
  rotaFixaId String?
  rotaFixa   RotaFixa? @relation(fields: [rotaFixaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([data])
}

// Região/trajeto nomeado (ex.: "Rota do Centro", "Rota Tiradentes")
model Rota {
  id         String     @id @default(cuid())
  nome       String
  ativo      Boolean    @default(true)
  rotasFixas RotaFixa[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// Coleta recorrente: aparece automaticamente nas Coletas do Dia nos dias marcados.
model RotaFixa {
  id         String        @id @default(cuid())
  periodo    PeriodoColeta
  dias       Json          @default("[1,2,3,4,5,6]") // dias da semana (1=Seg ... 6=Sáb)
  observacao String?
  ativo      Boolean       @default(true)

  coletorId String
  coletor   Coletor @relation(fields: [coletorId], references: [id], onDelete: Restrict)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  // Rota/região a que esta coleta fixa pertence (opcional)
  rotaId String?
  rota   Rota?   @relation(fields: [rotaId], references: [id], onDelete: SetNull)

  coletas Coleta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configurações simples chave/valor (ex.: senha de acesso às Coletas)
model Config {
  chave String @id
  valor String
}

// ─── PROSPECÇÃO ───

enum StatusProspeccao {
  CONTATO           // em contato, aguardando andamento
  FECHADO           // fechou negócio
  SEM_RETORNO       // cliente não retornou
  NAO_TEM_INTERESSE // não tem interesse
  SEM_PERFIL        // não é um perfil de cliente adequado
  DADOS_INCORRETO   // telefone/dados de contato errados
}

model Prospeccao {
  id          String           @id @default(cuid())
  data        DateTime         @db.Date
  nomeCliente String
  telefone    String?
  oQueVende   String?
  status      StatusProspeccao @default(CONTATO)

  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id], onDelete: Cascade)

  atendenteId String
  atendente   Atendente @relation(fields: [atendenteId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([data])
}
